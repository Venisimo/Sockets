<Window x:Class="ClientApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClientApp"
        mc:Ignorable="d"
        Title="Клиентское приложение" Height="550" Width="700">
    <Grid Height="534" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="0*"/>
        </Grid.RowDefinitions>
        <TextBox TextChanged="ClientLog_TextChanged" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Left" Height="430" Margin="413,66,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="266" Name="ClientLog"/>
        <ListBox HorizontalAlignment="Left" Height="265" Margin="22,73,0,0" VerticalAlignment="Top" Width="330" d:ItemsSource="{d:SampleData ItemCount=5}" 
                 RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" Name="FilesListBox" SelectionChanged="FilesListBox_SelectionChanged" 
                 MouseDoubleClick="FilesListBox_MouseDoubleClick" KeyDown="DriverList_KeyDown">
            <ListBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.335"/>
                    <TranslateTransform/>
                </TransformGroup>
            </ListBox.RenderTransform>
        </ListBox>
        <TextBox Name="FileContentTextBox"
          IsReadOnly="True"
          VerticalScrollBarVisibility="Auto"
          Visibility="Collapsed"
          HorizontalAlignment="Left"
          Height="265"
          Margin="22,73,0,0"
          Width="330"
          TextWrapping="Wrap"
          VerticalAlignment="Top" />
        <ComboBox IsEditable="True" HorizontalAlignment="Left" Height="26" Margin="22,33,0,0" VerticalAlignment="Top" Width="328" Name="DriverList" 
                  SelectionChanged="DriverList_SelectionChanged" KeyDown="DriverList_KeyDown"/>
        <Button Content="Соединиться" HorizontalAlignment="Left" Height="23" Margin="82,391,0,0" VerticalAlignment="Top" Width="89" Name="Button_Connect" Click="Connect_Click"/>
        <Button Content="Отключиться" HorizontalAlignment="Left" Height="23" Margin="193,391,0,0" VerticalAlignment="Top" Width="87" RenderTransformOrigin="0.621,0.494" Name="Button_Disconnect" Click="Disconnect_Click" IsEnabled="False"/>
        <TextBox HorizontalAlignment="Left" Height="20" Margin="85,350,0,0" TextWrapping="Wrap" Text="127.0.0.1" VerticalAlignment="Top" Width="105" Name="ipEntry"/>
        <TextBlock HorizontalAlignment="Left" Height="20" Margin="26,350,0,0" TextWrapping="Wrap" Text="IP-адрес:" VerticalAlignment="Top" Width="54"/>
        <Button Name="Button_Send" IsEnabled="False" Content="Передать серверу" HorizontalAlignment="Left" Height="27" Margin="113,435,0,0" VerticalAlignment="Top" Width="122" Click="SendToServer_Click"/>
        <Button Content="Выход" HorizontalAlignment="Left" Height="29" Margin="118,482,0,0" VerticalAlignment="Top" Width="112" Click="Button_Exit"/>
        <TextBox HorizontalAlignment="Left" Height="20" Margin="255,350,0,0" TextWrapping="Wrap" Text="4444" VerticalAlignment="Top" Width="66" Name="portEntry"/>
        <TextBlock HorizontalAlignment="Left" Margin="215,352,0,0" TextWrapping="Wrap" Text="Порт:" VerticalAlignment="Top" Height="16" Width="30"/>
        <TextBlock HorizontalAlignment="Left" Height="18" Margin="413,33,0,0" TextWrapping="Wrap" Text="Логи клиента" VerticalAlignment="Top" Width="177"/>

    </Grid>
</Window>
