<Window x:Class="ServerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ServerApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="350">
    <Grid HorizontalAlignment="Left" Width="350">
        <TextBox Name="ServerLog" TextChanged="ServerLog_TextChanged" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Left" Height="306" Margin="33,60,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="277"/>
        <Button Name="Close_Button" Content="Выход" HorizontalAlignment="Center" Height="22" Margin="0,480,0,0" VerticalAlignment="Top" Width="88" RenderTransformOrigin="0.511,0.025" Click="Close_Button_Click"/>
        <TextBlock HorizontalAlignment="Left" Height="20" Margin="31,398,0,0" TextWrapping="Wrap" Text="IP-адрес:" VerticalAlignment="Top" Width="52"/>
        <TextBox Name="ipEntry" HorizontalAlignment="Left" Height="20" Margin="88,398,0,0" TextWrapping="Wrap" Text="127.0.0.1" VerticalAlignment="Top" Width="103"/>
        <TextBox Name="portEntry" TextChanged="ServerLog_TextChanged"  HorizontalAlignment="Left" Height="20" Margin="238,398,0,0" TextWrapping="Wrap" Text="4444" VerticalAlignment="Top" Width="72"/>
        <TextBlock HorizontalAlignment="Left" Height="18" Margin="200,400,0,0" TextWrapping="Wrap" Text="Порт:" VerticalAlignment="Top" Width="32" RenderTransformOrigin="0.576,0.391"/>
        <Button Name="Run_Server" Content="Запустить сервер" HorizontalAlignment="Center" Height="22" Margin="0,442,0,0" VerticalAlignment="Top" Width="144" Click="Run_Server_Click"/>
        <TextBlock HorizontalAlignment="Center" Height="17" Margin="0,25,0,0" TextWrapping="Wrap" Text="Логи сервера" VerticalAlignment="Top" Width="86"/>
    </Grid>
</Window>
